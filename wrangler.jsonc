{
  "name": "durable-objects-webgame-starter",
  "main": "./src/worker-entry.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2024-12-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSION",
        "class_name": "GameSession"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3317bf333c4b453f832a8b8941479b6d"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameSession"
      ]
    }
  ]
}