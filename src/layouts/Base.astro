---
import '@styles/index.scss';
---
<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Durable Objects Webgame Starter</title>
		<script is:inline>
			// Must match isController() in src/utils/isController.ts
			if (new URLSearchParams(location.search).has('code')) {
				document.documentElement.classList.add('has-code');
			}
			// Polyfill React Fast Refresh stubs if not present (prevents ReferenceError on dynamic React imports in dev mode)
			if (typeof window !== 'undefined') {
				window.$RefreshReg$ = window.$RefreshReg$ || function () {};
				window.$RefreshSig$ = window.$RefreshSig$ || function () { return function (type) { return type; }; };
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import logCommitHash from "@utils/logCommitHash.ts";
	// This makes it easy to see which version of the site is being served
	logCommitHash();
</script>
