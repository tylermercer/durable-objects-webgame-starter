---
import { EXAMPLES } from '@examples/registry';
---

<div class="demo-switcher l-stack l-space-3xs">
  <label for="demo-switcher-select" class="u-step--1 u-weight-bold">Select Example:</label>
  <select id="demo-switcher-select" class="demo-switcher-select">
    {Object.entries(EXAMPLES).map(([id, example]) => (
      <option value={id}>{example.label}</option>
    ))}
  </select>
</div>

<script>
  const select = document.getElementById("demo-switcher-select") as HTMLSelectElement | null;
  if (select) {
    const saved = localStorage.getItem("selected_example");
    if (saved && Array.from(select.options).some(opt => opt.value === saved)) {
      select.value = saved;
    }

    select.addEventListener("change", () => {
      localStorage.setItem("selected_example", select.value);
      // Dispatch a custom event in case script needs to react immediately
      window.dispatchEvent(new CustomEvent("example-changed", { detail: { exampleId: select.value } }));
    });
  }
</script>

<style>
  .demo-switcher {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .demo-switcher-select {
    padding: 0.5rem 1rem;
    font-size: 1rem;
    border-radius: 6px;
    border: 1px solid var(--gray-6, #ccc);
    background-color: var(--gray-1, #fff);
    color: var(--gray-12, #000);
    cursor: pointer;
  }
</style>
