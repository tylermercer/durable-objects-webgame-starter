---
export interface Props {
  game?: string;
}

const { game } = Astro.props;
---

<div data-game={game} class="game-shell-container">
  <!-- Controller Shell -->
  <main class="controller-shell">
    <div id="name-screen" class="name-screen u-guttered-md u-hidden">
      <div class="name-card l-box l-stack l-space-s">
        <h1 class="u-step-2">Enter Your Name</h1>
        <p class="u-step--1 u-color-muted">Choose a display name before joining the game.</p>
        <form id="name-form" class="l-stack l-space-xs">
          <label for="player-name-input" class="u-step--1 u-bold">Player Name</label>
          <input
            type="text"
            id="player-name-input"
            class="player-name-input"
            placeholder="e.g. Alex"
            maxlength="20"
            autocomplete="off"
          />
          <button type="submit" class="btn-join-game">Join Game</button>
        </form>
      </div>
    </div>
    <div id="controller-main" class="controller-main-container">
      <header id="controller-header" class="controller-header u-guttered-md">
        <div class="controller-header-content">
          <h1 id="player-name" class="u-step-2">Controller</h1>
          <p id="controller-status" class="u-step--1">Connecting...</p>
        </div>
        <button id="fullscreen-btn" class="btn-fullscreen u-hidden" type="button">
          Fullscreen ⛶
        </button>
      </header>
      <div id="touch-surface" class="touch-surface">
        <div class="touch-instructions u-step-0 u-color-muted">
          Touch and drag anywhere on screen
        </div>
      </div>
    </div>

    <!-- Controller Full Dialog Modal -->
    <dialog id="controller-full-modal" class="room-modal controller-modal">
      <div class="modal-content l-stack l-space-m">
        <div class="modal-header l-stack l-space-xs">
          <h2 class="u-step-2">Room Full</h2>
          <p id="controller-full-message" class="u-step--1 u-color-muted">
            This game session has reached its maximum player limit.
          </p>
        </div>
        <div class="modal-actions">
          <button id="controller-full-close-btn" class="btn-done" type="button">Back</button>
        </div>
      </div>
    </dialog>

    <script src="@host/controller.ts"></script>
  </main>

  <!-- Console Shell -->
  <main class="console-shell">
    <header id="console-topbar" class="console-topbar">
      <span class="room-code-chip">Room <strong id="room-code-inline" class="room-code">----</strong></span>
      <button id="add-players-btn" class="add-players-btn u-hidden" type="button">
        Add Players
      </button>
    </header>

    <div id="game-viewport" class="game-viewport">
      <!-- Shown until a game has been chosen/loaded -->
      <div id="start-screen" class="start-screen l-stack l-space-m">
        <button id="new-game-btn" class="btn-new-game" type="button">
          New Game
        </button>
      </div>

      <!-- Empty on load. Host creates/clears this; games own everything inside it. -->
      <div id="game-surface" class="game-surface u-hidden"></div>
    </div>

    <!-- Native Modal Dialog for Desktop Console -->
    <dialog id="room-modal" class="room-modal">
      <div class="modal-content l-stack l-space-m">
        <div class="modal-header l-stack l-space-xs">
          <h2 class="u-step-2">Room Code: <strong id="room-code" class="room-code">----</strong></h2>
          <p class="u-step--1 u-color-muted">
            Scan QR code or open <span id="qr-url"></span> on your phone.
          </p>
        </div>

        <div class="qr-container">
          <canvas id="qr-canvas"></canvas>
        </div>

        <div class="modal-controllers l-stack l-space-xs">
          <div class="l-cluster l-space-between">
            <h3 id="connected-players-title" class="u-step-0">Connected Players</h3>
            <span id="player-limit-badge" class="player-limit-badge u-hidden"></span>
          </div>
          <div id="room-full-notice" class="room-full-notice u-hidden">
            Player limit reached
          </div>
          <div id="controller-list" class="controller-list l-stack l-space-xs">
            <p class="u-step--1 u-color-muted">Initializing room...</p>
          </div>
        </div>

        <div class="modal-actions">
          <button id="copy-link-btn" class="btn-copy-link" type="button">Copy Link</button>
          <button id="modal-close-btn" class="btn-done" type="button">Done</button>
        </div>
      </div>
    </dialog>

    <script src="@host/console.ts"></script>
  </main>

  <!-- Mobile Console / Fallback Join Form Card (narrow viewport without code) -->
  <div class="join-form-card">
    <div class="join-game-card l-box l-stack l-space-s">
      <h1 class="u-step-2">Join Game</h1>
      <p class="u-step--1 u-color-muted">Enter a room code to join an existing session as a controller.</p>
      <form id="join-game-form" method="GET" action="/" class="l-stack l-space-xs">
        <label for="join-code-input" class="u-step--1 u-bold">Room Code</label>
        <input
          type="text"
          id="join-code-input"
          name="code"
          class="join-code-input"
          placeholder="e.g. 2A3B4"
          maxlength="5"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="characters"
          required
        />
        <button type="submit" class="btn-join-game">Join Game</button>
      </form>
    </div>
  </div>
</div>

<style>
  .game-shell-container {
    width: 100%;
    height: 100%;
  }

  /* Default CSS shell visibility (CSS-first approach) */
  .console-shell { display: flex; flex-direction: column; height: 100dvh; position: relative; }
  .controller-shell { display: none; }
  .join-form-card { display: none; }

  @media (max-width: 768px) {
    .console-shell, .controller-shell { display: none !important; }
    .join-form-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100dvh;
      padding: 1rem;
    }
  }

  :global(html.has-code) .console-shell,
  :global(html.has-code) .join-form-card {
    display: none !important;
  }

  :global(html.has-code) .controller-shell {
    display: flex !important;
  }

  .room-code {
    font-size: 1.5em;
    letter-spacing: 2px;
    color: var(--color-primary-10, #0070f3);
  }

  .qr-container {
    background: white;
    padding: 8px;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .console-topbar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1rem;
    block-size: 3.5rem;
    border-bottom: 1px solid var(--gray-6, #ccc);
  }

  .room-code-chip {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .game-viewport {
    flex: 1 1 auto;
    min-height: 0;
    position: relative;
    overflow: hidden;
  }

  .game-surface {
    position: absolute;
    inset: 0;
  }

  :global(.u-hidden) {
    display: none !important;
  }

  .start-screen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    padding: 3rem 1rem;
  }

  .btn-new-game {
    font-size: 1.5rem;
    padding: 1rem 2.5rem;
    font-weight: bold;
    border-radius: 8px;
    background-color: var(--primary-9, #0070f3);
    color: var(--gray-contrast, #ffffff);
    border: none;
    cursor: pointer;
  }

  .btn-new-game:hover {
    background-color: var(--primary-10, #0051a2);
  }

  .add-players-btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: bold;
    border-radius: 6px;
    background-color: var(--gray-3, #eee);
    color: var(--gray-12, #111);
    border: 1px solid var(--gray-6, #ccc);
    cursor: pointer;
  }

  .add-players-btn:hover {
    background-color: var(--gray-4, #ddd);
  }

  /* Modal Styling */
  .room-modal {
    border: none;
    border-radius: 12px;
    padding: 1.5rem;
    max-width: 480px;
    width: 90%;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    background: var(--gray-1, #ffffff);
    color: var(--gray-12, #000000);
  }

  .room-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .btn-copy-link {
    padding: 0.5rem 1.25rem;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    background-color: var(--gray-3, #eee);
    color: var(--gray-12, #111);
    border: 1px solid var(--gray-6, #ccc);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-copy-link:hover {
    background-color: var(--gray-4, #ddd);
  }

  .btn-done {
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    background-color: var(--primary-9, #0070f3);
    color: #ffffff;
    border: none;
    cursor: pointer;
  }

  .btn-done:hover {
    background-color: var(--primary-10, #0051a2);
  }

  .player-limit-badge {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray-10, #666);
  }

  .room-full-notice {
    padding: 0.5rem 0.75rem;
    background-color: #fff3cd;
    color: #856404;
    border: 1px solid #ffeeba;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  /* Mobile Join Form Styling */
  .join-game-card {
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
  }

  .join-code-input {
    font-size: 1.25rem;
    padding: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid var(--gray-6, #ccc);
    border-radius: 6px;
    width: 100%;
  }

  .player-name-input {
    font-size: 1.25rem;
    padding: 0.75rem;
    text-align: center;
    border: 1px solid var(--gray-6, #ccc);
    border-radius: 6px;
    width: 100%;
  }

  .btn-join-game {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    background-color: var(--primary-9, #0070f3);
    color: #ffffff;
    border: none;
    cursor: pointer;
    width: 100%;
  }

  .btn-join-game:hover {
    background-color: var(--primary-10, #0051a2);
  }

  .controller-shell {
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    touch-action: none;
    user-select: none;
  }

  .name-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 1rem;
  }

  .name-card {
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
  }

  .controller-main-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100%;
  }

  .controller-header {
    padding: 1rem;
    background: rgba(0, 0, 0, 0.05);
    text-align: center;
    transition: background-color 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .controller-header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .btn-fullscreen {
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: bold;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.15);
    color: inherit;
    border: 1px solid rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-fullscreen:hover {
    background-color: rgba(0, 0, 0, 0.25);
  }

  .touch-surface {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.02);
    border: 2px dashed rgba(0, 0, 0, 0.15);
    margin: 1rem;
    border-radius: 12px;
    touch-action: none;
  }

  .touch-instructions {
    pointer-events: none;
    text-align: center;
  }

  :global(.status-badge) {
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: bold;
    background: #ccc;
    color: #333;
  }

  :global(.status-connected),
  :global(.status-live) {
    background: #2ecc40;
    color: white;
  }

  :global(.status-connecting),
  :global(.status-negotiating),
  :global(.status-reconnecting),
  :global(.status-grace-period) {
    background: #ff851b;
    color: white;
  }

  :global(.status-disconnected),
  :global(.status-failed),
  :global(.status-gone) {
    background: #ff4136;
    color: white;
  }
</style>
