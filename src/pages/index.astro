---
import Layout from '@layouts/Base.astro';
import { EXAMPLES } from '@examples/registry';
---

<Layout>
  <main class="home-shell l-stack l-space-m">
    <h1 class="u-step-2">Pick a game</h1>
    <div class="example-links" role="list">
      {Object.entries(EXAMPLES).map(([id, ex]) => (
        <a href={`/play/${id}`} class="example-link" role="listitem">{ex.label}</a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .home-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1rem;
    text-align: center;
  }

  .example-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
  }

  .example-link {
    display: block;
    padding: 0.75rem 1.25rem;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    border-radius: 8px;
    background-color: var(--gray-3, #eee);
    color: var(--gray-12, #111);
    border: 1px solid var(--gray-6, #ccc);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .example-link:hover {
    background-color: var(--gray-4, #ddd);
    border-color: var(--gray-8, #999);
  }
</style>
