---
import Layout from '@layouts/Base.astro';
import Zoom from '@components/Zoom.astro';
import { EXAMPLES, type ExampleId, DEFAULT_EXAMPLE } from '@examples/registry';

export const prerender = false;

const gameParam = Astro.url.searchParams.get('game') as ExampleId | null;
const game: ExampleId = (gameParam && gameParam in EXAMPLES) ? gameParam : DEFAULT_EXAMPLE;

const rawScale = Astro.url.searchParams.get('scale');
const scale = rawScale || '0.5';

const rawTransport = Astro.url.searchParams.get('transport');
const transport = rawTransport !== null ? rawTransport : 'relay';
const transportQuery = (transport === 'relay' || transport === 'rtc')
  ? `&force_transport=${encodeURIComponent(transport)}`
  : (transport === 'auto' ? '' : `&force_transport=${encodeURIComponent(transport)}`);

const consoleSrc = `/play/${game}?${transportQuery ? transportQuery.slice(1) : ''}`;
---

<Layout>
  <div class="portrait-container">
    <div class="half console-half">
      <div class="section-label">Console</div>
      <Zoom scale={scale} class="zoom-box">
        <iframe
          id="console-frame"
          src={consoleSrc}
          sandbox="allow-scripts allow-same-origin allow-forms"
          title="Console Frame"
        ></iframe>
      </Zoom>
    </div>
    <div class="half controller-half">
      <div class="section-label">Controller</div>
      <Zoom scale={scale} class="zoom-box">
        <iframe
          class="ctrl-frame"
          sandbox="allow-scripts allow-forms"
          title="Controller Frame"
        ></iframe>
      </Zoom>
    </div>
  </div>
</Layout>

<script define:vars={{ game, transportQuery }}>
  const consoleFrame = document.getElementById('console-frame');
  if (consoleFrame) {
    const gate = setInterval(() => {
      try {
        const code = consoleFrame.contentWindow?.sessionStorage?.getItem('console_room_code');
        if (!code) return;
        clearInterval(gate);
        document.querySelectorAll('.ctrl-frame').forEach((frame) => {
          frame.src = `/play/${game}?code=${encodeURIComponent(code)}${transportQuery}`;
        });
      } catch (e) {
        // storage access error while loading
      }
    }, 200);
  }
</script>

<style>
  :global(body, html) {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background-color: #0d1117;
  }

  .portrait-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
    box-sizing: border-box;
  }

  .half {
    position: relative;
    flex: 1;
    height: 50vh;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid #30363d;
    overflow: hidden;
  }

  .half:last-child {
    border-bottom: none;
  }

  .section-label {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 10;
    background: rgba(22, 27, 34, 0.85);
    color: #8b949e;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #30363d;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .zoom-box {
    width: 100%;
    height: 100%;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background-color: #0d1117;
  }
</style>
