---
import Layout from '@layouts/Base.astro';
import { EXAMPLES, type ExampleId, DEFAULT_EXAMPLE } from '@examples/registry';

export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const gameParam = Astro.url.searchParams.get('game') as ExampleId | null;
const game: ExampleId = (gameParam && gameParam in EXAMPLES) ? gameParam : DEFAULT_EXAMPLE;

const playersParam = Astro.url.searchParams.get('players');
const parsedPlayers = playersParam ? parseInt(playersParam, 10) : 2;
const playerCount = isNaN(parsedPlayers) || parsedPlayers < 1 ? 2 : parsedPlayers;

const rawTransport = Astro.url.searchParams.get('transport');
const transport = rawTransport !== null ? rawTransport : 'relay';
const transportQuery = (transport === 'relay' || transport === 'rtc')
  ? `&force_transport=${encodeURIComponent(transport)}`
  : (transport === 'auto' ? '' : `&force_transport=${encodeURIComponent(transport)}`);

const consoleSrc = `/play/${game}?${transportQuery ? transportQuery.slice(1) : ''}`;
---

<Layout>
  <div class="harness">
    <header class="harness-header">
      <div class="harness-title-group">
        <h1 class="harness-title">Dev Harness</h1>
        <span class="harness-badge">{EXAMPLES[game]?.label || game}</span>
      </div>
      <div class="harness-meta">
        <span>Players: {playerCount}</span>
        <span class="harness-dot">•</span>
        <span>Transport: {transport}</span>
      </div>
    </header>

    <main class="harness-layout">
      <section class="harness-section console-section">
        <h2 class="section-title">Console Frame</h2>
        <div class="frame-container console-container">
          <iframe
            id="console-frame"
            src={consoleSrc}
            allow="fullscreen 'none'"
            sandbox="allow-scripts allow-same-origin allow-forms"
            title="Console Frame"
          ></iframe>
        </div>
      </section>

      <section class="harness-section controllers-section">
        <h2 class="section-title">Controller Frames ({playerCount})</h2>
        <div class="controllers-grid">
          {Array.from({ length: playerCount }).map((_, index) => (
            <div class="controller-card">
              <div class="controller-card-header">
                <span>Player {index + 1}</span>
              </div>
              <div class="frame-container controller-container">
                <iframe
                  class="ctrl-frame"
                  allow="fullscreen 'none'"
                  sandbox="allow-scripts allow-forms"
                  title={`Controller ${index + 1} Frame`}
                ></iframe>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  </div>
</Layout>

<script define:vars={{ game, transportQuery }}>
  const consoleFrame = document.getElementById('console-frame');
  if (consoleFrame) {
    let paired = false;

    window.addEventListener('message', (event) => {
      if (paired) return;
      if (event.data && event.data.type === 'CONSOLE_ROOM_READY' && event.data.code) {
        paired = true;
        const code = event.data.code;
        document.querySelectorAll('.ctrl-frame').forEach((frame) => {
          frame.src = `/play/${game}?code=${encodeURIComponent(code)}${transportQuery}`;
        });
      }
    });

    const poll = setInterval(() => {
      if (paired) {
        clearInterval(poll);
        return;
      }
      try {
        consoleFrame.contentWindow?.postMessage({ type: 'GET_CONSOLE_ROOM_CODE' }, '*');
      } catch (e) {
        // ignore cross-origin/loading errors
      }
    }, 200);
  }
</script>

<style>
  .harness {
    min-height: 100vh;
    background-color: #0d1117;
    color: #c9d1d9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    padding: 1rem;
    box-sizing: border-box;
  }

  .harness-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .harness-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .harness-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: #f0f6fc;
  }

  .harness-badge {
    background-color: #238636;
    color: #ffffff;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .harness-meta {
    font-size: 0.875rem;
    color: #8b949e;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .harness-dot {
    color: #484f58;
  }

  .harness-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .harness-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .frame-container {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    overflow: hidden;
  }

  .console-container {
    height: 480px;
  }

  #console-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .controllers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
  }

  .controller-card {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .controller-card-header {
    background-color: #21262d;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #f0f6fc;
    border-bottom: 1px solid #30363d;
  }

  .controller-container {
    height: 560px;
    border: none;
    border-radius: 0;
  }

  .ctrl-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background-color: #0d1117;
  }
</style>
